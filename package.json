{
  "name": "dsh-tizi-switch",
  "version": "1.1.0",
  "description": "梯子开关 — 在 DeepSeek Harness 运行中随时切换出网代理，不重启、不改系统代理。",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "bzyyyy-china",
    "url": "https://github.com/bzyyyy-china"
  },
  "homepage": "https://github.com/bzyyyy-china/dsh-tizi-switch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bzyyyy-china/dsh-tizi-switch.git"
  },
  "bugs": {
    "url": "https://github.com/bzyyyy-china/dsh-tizi-switch/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "proxy",
    "clash",
    "switch",
    "http-proxy",
    "runtime-switch"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.2+": "compatible"
      }
    }
  }
}
